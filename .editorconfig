# EditorConfig — fuerza UTF-8 en todos los archivos
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,tsx,js,jsx,json,css,html,md}]
charset = utf-8

[*.md]
trim_trailing_whitespace = false
