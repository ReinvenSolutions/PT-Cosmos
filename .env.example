# Database - Usar Supabase Postgres para datos en tiempo real
# Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# (Ya no usamos Neon ni Cloudinary; imágenes en Supabase Storage)
DATABASE_URL="postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres"

# Supabase Storage (imágenes)
SUPABASE_URL="https://xxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key desde Supabase Dashboard → Settings → API]"

# OpenAI (opcional): para extraer planes desde PDF/Word con IA y para Cosmos (chat + voz)
# Si no se define, se usa parser heurístico (menos flexible) y Cosmos queda desactivado
# OPENAI_API_KEY=sk-...

# LiveKit (opcional): voz in-app de Cosmos. Sin estas claves el chat de texto sigue funcionando.
# Crea un proyecto en https://cloud.livekit.io y copia URL, API Key y API Secret.
# En local, `npm run dev` arranca el worker de voz si estas claves existen.
# Proceso aparte (producción o si desactivas el autostart): npm run cosmos:agent
# COSMOS_AGENT_AUTOSTART=0
# LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
# LIVEKIT_API_KEY=APIxxxxxxxx
# LIVEKIT_API_SECRET=secret
# LIVEKIT_AGENT_NAME=cosmos

# Environment
NODE_ENV=development

# Session Secret (generate with: openssl rand -base64 32)
SESSION_SECRET=your-secret-key-here

# Server Port
PORT=5001

# URL base del frontend (para enlaces de reset de contraseña, etc.)
# En desarrollo: http://localhost:5173 | En producción: https://tu-dominio.com
APP_URL=http://localhost:5173

# Brevo - Envío de correos (2FA, recuperación contraseña, notificaciones)
# Producción usa la API REST. SMTP suele dar timeout en Railway.
SMTP_FROM=info@cosmosviajes.com
SMTP_FROM_NAME=Cosmos Viajes
BREVO_API_KEY=xkeysib-tu-api-key-aqui

# NO actives "IPs autorizadas" en Brevo. Railway cambia de IP y el login 2FA
# queda bloqueado en producción. Si ya está activo, desactívalo aquí:
# https://app.brevo.com/security/authorised_ips
# En development, si Brevo rechaza la IP, el código 2FA se muestra en pantalla.
